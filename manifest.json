{
  "manifest_version": 3,
  "name": "__MSG_appName__",
  "default_locale": "en",
  "version": "0.8.1",
  "description": "__MSG_appDesc__",
  "minimum_chrome_version": "105",
  "permissions": [
    "storage",
    "unlimitedStorage",
    "declarativeNetRequest",
    "alarms",
    "scripting",
    "tabs",
    "contextMenus",
    "webNavigation",
    "activeTab"
  ],
  "optional_permissions": [
    "bookmarks",
    "history",
    "downloads",
    "webRequest",
    "notifications"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background/index.js"
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "i18n/i18n.js",
        "i18n/dict-en-content.js",
        "content/00-lib.js",
        "content/10-css.js",
        "content/20-detector.js",
        "content/30-guard.js",
        "content/40-youtube.js",
        "content/50-picker.js",
        "content/60-bridge.js",
        "content/65-antidodge.js",
        "content/70-toolbox.js",
        "content/80-flowfix.js",
        "content/85-fx.js"
      ],
      "css": [
        "content/picker.css"
      ],
      "run_at": "document_start",
      "all_frames": true,
      "match_about_blank": false
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "content/inject-guard.js"
      ],
      "matches": [
        "http://*/*",
        "https://*/*"
      ]
    }
  ],
  "action": {
    "default_popup": "ui/popup.html",
    "default_title": "__MSG_appName__",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_ui": {
    "page": "ui/options.html",
    "open_in_tab": true
  },
  "commands": {
    "zz-pick": {
      "suggested_key": {
        "default": "Alt+Z"
      },
      "description": "__MSG_cmdPick__"
    },
    "zz-ai-page": {
      "suggested_key": {
        "default": "Alt+A"
      },
      "description": "__MSG_cmdAiPage__"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "zerozen@local.extension",
      "strict_min_version": "128.0"
    }
  }
}
