{
  "manifest_version": 3,
  "name": "ZeroZen 广告净化器",
  "version": "0.5.0",
  "description": "跨浏览器广告与弹窗屏蔽：规则引擎 + AI 识别 + 收藏夹批量扫描，支持自定义规则导入导出。",
  "minimum_chrome_version": "105",
  "permissions": [
    "storage",
    "unlimitedStorage",
    "declarativeNetRequest",
    "scripting",
    "tabs",
    "bookmarks",
    "contextMenus",
    "webNavigation",
    "webRequest",
    "history",
    "downloads",
    "activeTab"
  ],
  "host_permissions": ["http://*/*", "https://*/*"],
  "background": {
    "service_worker": "background/index.js",
    "scripts": [
      "background/lib-compat.js",
      "background/ai-prompt.js",
      "background/rule-format.js",
      "background/store.js",
      "background/profiles.js",
      "background/rule-index.js",
      "background/dnr.js",
      "background/ai.js",
      "background/bookmarks.js",
      "background/learn.js",
      "background/counts.js",
      "background/sniffer.js",
      "background/scanner.js",
      "background/autopilot.js",
      "background/menus.js",
      "background/messages.js",
      "background/main.js"
    ]
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": [
        "content/00-lib.js",
        "content/10-css.js",
        "content/20-detector.js",
        "content/30-guard.js",
        "content/40-youtube.js",
        "content/50-picker.js",
        "content/60-bridge.js",
        "content/65-antidodge.js",
        "content/70-toolbox.js"
      ],
      "css": ["content/picker.css"],
      "run_at": "document_start",
      "all_frames": true,
      "match_about_blank": false
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["content/inject-guard.js"],
      "matches": ["http://*/*", "https://*/*"]
    }
  ],
  "action": {
    "default_popup": "ui/popup.html",
    "default_title": "ZeroZen 广告净化器",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_ui": {
    "page": "ui/options.html",
    "open_in_tab": true
  },
  "commands": {
    "zz-pick": {
      "suggested_key": { "default": "Alt+Z" },
      "description": "选取元素并屏蔽"
    },
    "zz-ai-page": {
      "suggested_key": { "default": "Alt+A" },
      "description": "AI 识别本页烦人广告"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "zerozen@local.extension",
      "strict_min_version": "128.0"
    }
  }
}
