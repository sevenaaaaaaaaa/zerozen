        "tuniu.com"
      ]
    },
    {
      "kind": "cosmetic",
      "action": "hide",
      "selector": ":is([class^='ad-'], [class*=' ad-'])",
      "note": "广告容器（ad-* 类名）",
      "domains": [
        "booking.com",
        "agoda.com",
        "airbnb.com",
        "expedia.com",
        "hotels.com"
      ]
    },
    {
      "kind": "cosmetic",
      "action": "hide",
      "selector": ":is([class^='ads-'], [class*=' ads-'])",
      "note": "广告容器（ads-* 类名）",
      "domains": [
        "booking.com",
        "agoda.com",
        "airbnb.com",
        "expedia.com",
        "hotels.com"
      ]
    },
    {
      "kind": "cosmetic",
      "action": "hide",
      "selector": ":is([class^='ad-'], [class*=' ad-'])",
      "note": "广告容器（ad-* 类名）",
      "domains": [
        "tripadvisor.com",
        "kayak.com",
        "skyscanner.net",
        "momondo.com"
      ]
    },
    {
      "kind": "cosmetic",
      "action": "hide",
      "selector": ":is([class^='ads-'], [class*=' ads-'])",
      "note": "广告容器（ads-* 类名）",
      "domains": [
        "tripadvisor.com",
        "kayak.com",
        "skyscanner.net",
        "momondo.com"
      ]
    },
    {
      "kind": "cosmetic",
      "action": "hide",
      "selector": "[data-testid^='ad-']",
      "note": "OTA 广告组件",
      "domains": [
        "booking.com",
        "agoda.com",
        "expedia.com"
      ]
    },
    {
      "kind": "cosmetic",
