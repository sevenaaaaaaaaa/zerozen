{
  "id": "youtube",
  "name": "YouTube",
  "desc": "首页与播放页广告位、视频内广告自动跳过、反广告拦截弹窗",
  "rules": [
    { "kind": "cosmetic", "action": "hide", "selector": "ytd-display-ad-renderer", "note": "首页展示广告" },
    { "kind": "cosmetic", "action": "hide", "selector": "ytd-promoted-sparkles-web-renderer", "note": "信息流推广" },
    { "kind": "cosmetic", "action": "hide", "selector": "ytd-promoted-sparkles-text-search-renderer", "note": "搜索推广" },
    { "kind": "cosmetic", "action": "hide", "selector": "ytd-promoted-video-renderer", "note": "推广视频" },
    { "kind": "cosmetic", "action": "hide", "selector": "ytd-compact-promoted-video-renderer", "note": "侧栏推广视频" },
    { "kind": "cosmetic", "action": "hide", "selector": "ytd-in-feed-ad-layout-renderer", "note": "信息流广告布局" },
    { "kind": "cosmetic", "action": "hide", "selector": "ytd-ad-slot-renderer", "note": "通用广告槽" },
    { "kind": "cosmetic", "action": "hide", "selector": "ytd-banner-promo-renderer", "note": "顶部促销条" },
    { "kind": "cosmetic", "action": "hide", "selector": "ytd-statement-banner-renderer", "note": "顶部声明横幅" },
    { "kind": "cosmetic", "action": "hide", "selector": "ytd-companion-slot-renderer", "note": "播放页伴生广告" },
    { "kind": "cosmetic", "action": "hide", "selector": "ytd-action-companion-ad-renderer", "note": "播放页行动广告" },
    { "kind": "cosmetic", "action": "hide", "selector": "ytd-player-legacy-desktop-watch-ads-renderer", "note": "旧版播放页广告" },
    { "kind": "cosmetic", "action": "hide", "selector": "ytd-merch-shelf-renderer", "note": "商品货架" },
    { "kind": "cosmetic", "action": "hide", "selector": "ytd-mealbar-promo-renderer", "note": "会员推广弹窗" },
    { "kind": "cosmetic", "action": "hide", "selector": "#masthead-ad", "note": "顶栏广告" },
    { "kind": "cosmetic", "action": "hide", "selector": "#player-ads", "note": "播放页广告栏" },
    { "kind": "cosmetic", "action": "hide", "selector": ".ytp-ad-overlay-container", "note": "视频覆盖广告" },
    { "kind": "cosmetic", "action": "hide", "selector": ".ytp-ad-overlay-slot", "note": "视频覆盖广告位" },
    { "kind": "cosmetic", "action": "hide", "selector": ".ytp-ad-module", "note": "播放器广告模块" },
    { "kind": "cosmetic", "action": "hide", "selector": ".ytp-ad-progress-list", "note": "广告进度条" },
    { "kind": "cosmetic", "action": "hide", "selector": ".ytp-ad-message-container", "note": "广告提示层" },
    { "kind": "cosmetic", "action": "hide", "selector": ".ytp-featured-product", "note": "视频内商品浮层" },
    { "kind": "cosmetic", "action": "hide", "selector": "ytd-engagement-panel-section-list-renderer[target-id='engagement-panel-ads']", "note": "广告信息面板" },
    { "kind": "cosmetic", "action": "hide", "selector": "ytd-rich-item-renderer:has(ytd-ad-slot-renderer)", "note": "首页广告卡片" },
    { "kind": "cosmetic", "action": "hide", "selector": "ytd-rich-item-renderer:has(ytd-in-feed-ad-layout-renderer)", "note": "首页信息流广告" },
    { "kind": "cosmetic", "action": "hide", "selector": "ytd-rich-item-renderer:has(ytd-display-ad-renderer)", "note": "首页展示广告卡片" },
    { "kind": "cosmetic", "action": "hide", "selector": "ytd-video-renderer:has(ytd-promoted-sparkles-text-search-renderer)", "note": "搜索结果推广" },
    { "kind": "cosmetic", "action": "hide", "selector": "ytd-item-section-renderer:has(ytd-promoted-sparkles-web-renderer)", "note": "推广区块" },
    { "kind": "cosmetic", "action": "hide", "selector": "ytd-reel-video-renderer:has(.ytd-ad-slot-renderer)", "note": "Shorts 广告" },
    { "kind": "cosmetic", "action": "hide", "selector": "ytd-shorts-video-renderer:has(ytd-ad-slot-renderer)", "note": "Shorts 广告" },
    { "kind": "cosmetic", "action": "hide", "selector": "ytd-popup-container:has(ytd-enforcement-message-view-model)", "note": "反广告拦截弹窗" },
    { "kind": "cosmetic", "action": "hide", "selector": "tp-yt-paper-dialog:has(ytd-enforcement-message-view-model)", "note": "反广告拦截弹窗" },

    { "kind": "network", "action": "block", "filter": "||youtube.com/pagead/", "note": "YouTube 广告请求" },
    { "kind": "network", "action": "block", "filter": "||youtube.com/ptracking", "note": "播放埋点" },
    { "kind": "network", "action": "block", "filter": "||youtube.com/get_midroll_info", "note": "中场广告调度" },
    { "kind": "network", "action": "block", "filter": "||youtube.com/api/stats/ads", "note": "广告统计" },
    { "kind": "network", "action": "block", "filter": "||googleads.g.doubleclick.net^", "note": "YouTube 广告投放" },
    { "kind": "network", "action": "block", "filter": "||static.doubleclick.net^", "note": "YouTube 广告素材" },
    { "kind": "network", "action": "block", "filter": "||youtube.com/api/stats/qoe?*adformat", "note": "广告播放质量上报" }
  ]
}
