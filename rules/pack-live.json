{
  "id": "live",
  "name": "直播平台",
  "desc": "斗鱼 / 虎牙 / B站直播 / Twitch 的广告位、弹层与推广浮窗",
  "rules": [
    {
      "kind": "cosmetic",
      "action": "hide",
      "selector": "#js-ad",
      "note": "斗鱼广告位",
      "domains": [
        "douyu.com"
      ]
    },
    {
      "kind": "cosmetic",
      "action": "hide",
      "selector": ".ad-container",
      "note": "斗鱼广告容器",
      "domains": [
        "douyu.com"
      ]
    },
    {
      "kind": "cosmetic",
      "action": "hide",
      "selector": "[class*='room-ad']",
      "note": "斗鱼直播间广告",
      "domains": [
        "douyu.com"
      ]
    },
    {
      "kind": "cosmetic",
      "action": "hide",
      "selector": "[class^='ad-banner']",
      "note": "斗鱼横幅广告",
      "domains": [
        "douyu.com"
      ]
    },
    {
      "kind": "cosmetic",
      "action": "hide",
      "selector": "[class*=' ad-banner']",
      "note": "斗鱼横幅广告",
      "domains": [
        "douyu.com"
      ]
    },
    {
      "kind": "cosmetic",
