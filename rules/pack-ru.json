{
  "id": "ru",
  "name": "俄罗斯 / 独联体",
  "desc": "Yandex / Mail.ru / Rambler / RIA / Lenta / Habr / VK 等",
  "rules": [
    {
      "kind": "cosmetic",
      "action": "hide",
      "selector": ".js-banner",
      "note": "Lenta 横幅广告",
      "domains": [
        "lenta.ru"
      ]
    },
    {
      "kind": "cosmetic",
      "action": "hide",
      "selector": ".custom-banner",
      "note": "Lenta 自定义横幅",
      "domains": [
        "lenta.ru"
      ]
    },
    {
      "kind": "cosmetic",
      "action": "hide",
      "selector": ".banner-card",
      "note": "Lenta 广告卡",
      "domains": [
        "lenta.ru"
      ]
    },
    {
      "kind": "cosmetic",
      "action": "hide",
      "selector": "[class^='banner--']",
      "note": "Lenta 原生广告",
      "domains": [
        "lenta.ru"
      ]
    },
    {
      "kind": "cosmetic",
      "action": "hide",
      "selector": ":is([class^='ad-'], [class*=' ad-'])",
      "note": "广告容器（ad-* 类名）",
      "domains": [
        "rambler.ru"
      ]
    },
    {
      "kind": "cosmetic",
      "action": "hide",
